{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactors"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build System"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "style",
      "section": "Styles"
    },
    {
      "type": "chore",
      "section": "Miscellaneous"
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "vane",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "vane/backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "vane/frontend/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
