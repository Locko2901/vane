generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiToken {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  ciphertext  String
  lastValid   Boolean?
  lastChecked DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hosts       Host[]
  srvRecords  SrvRecord[]
}

model Host {
  id          Int      @id @default(autoincrement())
  zone        String
  hostname    String
  recordType  String   @default("A")
  proxied     Boolean  @default(true)
  ttl         Int      @default(1)
  description String?
  enabled     Boolean  @default(true)
  tokenId     Int
  token       ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([zone, hostname, recordType])
}

model SrvRecord {
  id           Int       @id @default(autoincrement())
  zone         String
  hostname     String
  service      String
  proto        String    @default("tcp")
  priority     Int       @default(0)
  weight       Int       @default(0)
  port         Int
  target       String
  ttl          Int       @default(1)
  description  String?
  enabled      Boolean   @default(true)
  tokenId      Int
  token        ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  cfRecordId   String?
  syncState    String    @default("pending")
  lastError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([zone, hostname, service, proto])
}

model Setting {
  key   String @id
  value String
}

model ConfigHistory {
  id        Int      @id @default(autoincrement())
  content   String
  note      String?
  createdAt DateTime @default(now())
}
