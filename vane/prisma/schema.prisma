generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiToken {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  ciphertext  String
  lastValid   Boolean?
  lastChecked DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hosts       Host[]
}

model Host {
  id          Int      @id @default(autoincrement())
  zone        String
  hostname    String
  recordType  String   @default("A")
  proxied     Boolean  @default(true)
  ttl         Int      @default(1)
  description String?
  enabled     Boolean  @default(true)
  tokenId     Int
  token       ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([zone, hostname, recordType])
}

model Setting {
  key   String @id
  value String
}

model ConfigHistory {
  id        Int      @id @default(autoincrement())
  content   String
  note      String?
  createdAt DateTime @default(now())
}
