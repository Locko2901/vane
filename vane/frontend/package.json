{
  "name": "vane-frontend",
  "version": "1.2.0",
  "description": "Vane frontend — web UI for dynamic DNS on Cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
