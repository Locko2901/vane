{
  "name": "vane-backend",
  "version": "1.2.0",
  "description": "Vane backend — API for dynamic DNS on Cloudflare",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run prisma:generate && npm run prisma:push",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/*.test.ts",
    "start": "node dist/index.js",
    "seed:bogus": "tsx src/scripts/seed-bogus.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "mkdir -p prisma && cp ../prisma/schema.prisma prisma/schema.prisma && prisma generate",
    "prisma:push": "mkdir -p prisma && cp ../prisma/schema.prisma prisma/schema.prisma && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dockerode": "^4.0.2",
    "express": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.0.0",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
